# Arbeitsdatei für den Kern-Lernpfad. Keine Zugangsdaten eintragen.
export COMPONENT_NAME='example.org/team/target-application'
export COMPONENT_VERSION='0.1.0'

# Die vom Zielcluster erreichbare OCI Registry, ohne abschließenden Slash.
export LOCAL_REGISTRY='registry.example.internal:5000'
export OCM_REPOSITORY="${LOCAL_REGISTRY}/ocm"

# Verzeichnis für generierte, nicht einzucheckende Build-Artefakte.
export DELIVERY_DIR='./delivery/target-application'

# Leichtgewichtiges lokales Vorbereitungslabor mit k3d.
export LAB_CLUSTER='ocm-lab'
export LAB_REGISTRY='k3d-ocm-registry.localhost:5000'
export LAB_INGRESS_PORT='8080'
