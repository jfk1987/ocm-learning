# Working file for the core learning path. Do not add credentials.
export COMPONENT_NAME='example.org/team/target-application'
export COMPONENT_VERSION='0.1.0'

# The local lab registry, without a scheme or trailing slash. The host and
# the Kubernetes manifests deliberately use the same image reference.
export LOCAL_REGISTRY='localhost:5000'
export OCM_REPOSITORY="http://${LOCAL_REGISTRY}/ocm"

# Directory for generated build artifacts that must not be committed.
export DELIVERY_DIR='./delivery/target-application'

# Lightweight local preparation lab with k3d.
export LAB_CLUSTER='ocm-lab'
export LAB_REGISTRY='localhost:5000'
export LAB_REGISTRY_CONTAINER='k3d-registry.localhost:5000'
export LAB_INGRESS_PORT='8080'
export FORGEJO_URL="http://forgejo.ocm.test:${LAB_INGRESS_PORT}"
export WOODPECKER_URL="http://woodpecker.ocm.test:${LAB_INGRESS_PORT}"
